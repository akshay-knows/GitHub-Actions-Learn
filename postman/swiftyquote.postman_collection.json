{
  "info": {
    "name": "SwiftyQuote Simple Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Create quotation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8081/api/quotations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 101,\n  \"customerName\": \"Demo Dealer\",\n  \"items\": [\n    {\n      \"productName\": \"Modular Switch\",\n      \"quantity\": 10,\n      \"unitPrice\": 250\n    },\n    {\n      \"productName\": \"MCB\",\n      \"quantity\": 2,\n      \"unitPrice\": 500\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "2 List paginated quotations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8081/api/quotations?page=0&size=10"
      }
    },
